# MongoDB connection string (e.g. from Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/fitnessapp?retryWrites=true&w=majority
PORT=5001
# Generate long random strings, e.g. `openssl rand -hex 32`
ACCESS_TOKEN_SECRET=replace-with-random-string
REFRESH_TOKEN_SECRET=replace-with-another-random-string
CALORIE_NINJAS_API_KEY=your-calorie-ninjas-key
ANTHROPIC_API_KEY=your-anthropic-key
